{
  "name": "uncage",
  "version": "1.0.0",
  "description": "Local website cloner that exports standalone static HTML, CSS, and JavaScript.",
  "main": "src/index.ts",
  "bin": {
    "uncage": "./bin/uncage.js"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "tsx src/index.ts --ui",
    "uncage": "tsx src/index.ts",
    "ui": "tsx src/index.ts --ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "crawler",
    "scraper",
    "cloner",
    "framer",
    "webflow",
    "static-html",
    "html",
    "playwright",
    "web-ui"
  ],
  "author": "Nightteye",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nightteye/uncage.git"
  },
  "homepage": "https://github.com/Nightteye/uncage#readme",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.6.0",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "cssnano": "^8.0.8",
    "playwright": "^1.62.1",
    "playwright-extra": "^4.3.6",
    "postcss": "^8.5.26",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "purgecss": "^8.0.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
